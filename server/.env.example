# Copy to server/.env for local development.
PORT=4100
CLIENT_ORIGIN=http://localhost:5273
JWT_SECRET=dev-insecure-secret
# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Force admins on the default password to change it (on by default in production)
FORCE_DEFAULT_PASSWORD_CHANGE=0
# Hosted SQLite (optional). Leave unset to use a local file in server/data.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=...
